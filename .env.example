# LumiLivre API local environment template.
# Copy this file to .env, replace placeholders, then load it with:
#   set -a
#   source .env
#   set +a
#
# The same .env file is compatible with docker run --env-file .env.

LUMILIVRE_DB_URL=jdbc:postgresql://localhost:5432/postgres
LUMILIVRE_DB_USER=postgres
LUMILIVRE_DB_PASSWORD=lumilivre

# Use a random secret with at least 64 characters for local development.
LUMILIVRE_JWT_SECRET=replace-me-with-a-random-64-plus-character-jwt-secret-for-local-dev
LUMILIVRE_JWT_EXPIRATION=86400000

LUMILIVRE_MAIL_HOST=smtp.gmail.com
LUMILIVRE_MAIL_PORT=587
LUMILIVRE_MAIL_USERNAME=replace-me-smtp-user
LUMILIVRE_MAIL_PASSWORD=replace-me-smtp-password

LUMILIVRE_SUPABASE_URL=https://replace-me.supabase.co
LUMILIVRE_SUPABASE_KEY=replace-me-supabase-key

LUMILIVRE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Keep local cache in memory unless you are explicitly testing Redis.
LUMILIVRE_CACHE_TYPE=simple
# LUMILIVRE_REDIS_URL=redis://localhost:6379
