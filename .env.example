# LumiLivre API - template de ambiente local.
#
# Uso:
#   cp .env.example .env
#   # edite o .env com valores reais
#   set -a; source .env; set +a   # Git Bash / WSL
#   ./mvnw spring-boot:run
#
# O mesmo .env serve para `docker run --env-file .env lumilivre-api`.
# Em PowerShell, use o runbook em docs/runbooks/local_environment.md.

# ============================================================
# Banco de dados (Supabase Postgres via Session pooler 5432)
# ============================================================
LUMILIVRE_DB_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
LUMILIVRE_DB_USER=postgres.replace-me-project-ref
LUMILIVRE_DB_PASSWORD=replace-me-db-password

# ============================================================
# JWT (backend)
# Gere >= 64 caracteres aleatorios. Ex.: `openssl rand -base64 48`.
# ============================================================
LUMILIVRE_JWT_SECRET=replace-me-with-a-random-64-plus-character-jwt-secret
LUMILIVRE_JWT_EXPIRATION=86400000

# ============================================================
# SMTP (Gmail App Password recomendado)
# ============================================================
LUMILIVRE_MAIL_HOST=smtp.gmail.com
LUMILIVRE_MAIL_PORT=587
LUMILIVRE_MAIL_USERNAME=replace-me-smtp-user
LUMILIVRE_MAIL_PASSWORD=replace-me-smtp-app-password

# ============================================================
# Supabase
#   LUMILIVRE_SUPABASE_URL              -> https://<project-ref>.supabase.co
#   LUMILIVRE_SUPABASE_KEY              -> publishable / anon key (uso publico)
#   LUMILIVRE_SUPABASE_SERVICE_ROLE_KEY -> service_role JWT (so backend; bypassa RLS)
#
# Onde achar no painel: Project Settings -> API.
# Nunca exponha a service_role em frontend / mobile.
# ============================================================
LUMILIVRE_SUPABASE_URL=https://replace-me-project-ref.supabase.co
LUMILIVRE_SUPABASE_KEY=replace-me-publishable-anon-key
LUMILIVRE_SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-jwt

# ============================================================
# CORS - origens permitidas separadas por virgula.
# ============================================================
LUMILIVRE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ============================================================
# Cache. Use 'redis' em prod; 'simple' para rodar sem dependencia extra.
# ============================================================
LUMILIVRE_CACHE_TYPE=simple
# LUMILIVRE_REDIS_URL=redis://localhost:6379
