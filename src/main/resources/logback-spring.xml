<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- JSON structured logging for prod/staging -->
    <springProfile name="prod,staging">
        <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>userRole</includeMdcKeyName>
                <customFields>{"app":"lumilivre-api"}</customFields>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_STDOUT"/>
        </root>
    </springProfile>

    <!-- Human-readable logging for dev -->
    <springProfile name="dev,default">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level [%X{correlationId}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="br.com.lumilivre" level="DEBUG"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>

        <!-- O message source registra CADA busca de chave, e sao dezenas por
             requisicao (uma por bundle da cadeia de fallback, vezes cinco
             idiomas). Fica DEBUG do pacote, mas nao este: o ruido esconde o
             log util e, quando o stdout e limitado, cada linha custa
             centenas de milissegundos e trava a thread da requisicao. -->
        <logger name="br.com.lumilivre.api.config.I18nConfig$FallbackChainMessageSource" level="INFO"/>
    </springProfile>

</configuration>
